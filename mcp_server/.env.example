# Graphiti's own internal LLM + embedding calls (entity/relationship extraction
# from episodes) — separate from Teacher's own GEMINI_API_KEY in ../.env, but
# it's the same key value: Google AI Studio, https://aistudio.google.com/apikey.
# Graphiti's config (see ./config.yaml) reads GOOGLE_API_KEY, not GEMINI_API_KEY —
# different env var name, same underlying key.
GOOGLE_API_KEY=

# Optional: override the model config.yaml defaults to (Gemini's Flash tier,
# matching Teacher's own default — see ../README.md).
MODEL_NAME=gemini-3.7-flash
EMBEDDER_MODEL=gemini-embedding-001

# Episode processing concurrency. Default: 10. Lower this if you hit 429s from
# Google's API (mirrors the SEMAPHORE_LIMIT guidance in graphiti's own docs).
SEMAPHORE_LIMIT=10

# Namespaces all graph data written by this server. Left at the default so
# Teacher's courses share one graph (needed for later cross-course overlap
# detection, Phase 5) rather than being siloed per course.
GRAPHITI_GROUP_ID=main

# FalkorDB (bundled in the same container) — leave blank/default for local use.
FALKORDB_PASSWORD=
FALKORDB_DATABASE=default_db

# FalkorDB Browser UI at http://localhost:3000 — set to 0 to disable.
BROWSER=1
