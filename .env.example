# Which LLM vendor the Orchestrator calls: "anthropic" or "gemini". Default: gemini.
LLM_PROVIDER=gemini

# Google AI Studio (Gemini) API key — required when LLM_PROVIDER=gemini.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API key — required when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily API key — required for web search (Tavily MCP server). Get one at https://tavily.com/
TAVILY_API_KEY=

# Model used by the Orchestrator for every LLM call. Optional — if unset, each
# provider uses its own sensible mid/high-tier default (see README). Set this
# to override, e.g. "gemini-2.5-pro" or "claude-opus-5".
ORCHESTRATOR_MODEL=

# Max retry attempts when a model response fails schema validation before the Orchestrator
# surfaces a hard failure to the caller. Default: 2.
ORCHESTRATOR_MAX_RETRIES=2

# Where the Orchestrator writes its JSONL cost/latency log. Default: ./logs/orchestrator.jsonl
ORCHESTRATOR_LOG_PATH=

# SQLite file path for persisted course data (Phase 3). Default: ./data/teacher.db
TEACHER_DB_PATH=

# Minimum "article"-type sources a lesson needs before the Material Aggregator's
# one-shot backfill trigger fires (Phase 3). Default: 2.
MATERIAL_MIN_VALID_SOURCES=2

# Where src/memoryGraph/ connects for the Memory Graph (Phase 3.5) — override only if that service
# runs on a different host/port than the default. See README, "Setting up the Memory Graph
# (Docker)" for how to actually stand up the service this URL points at.
# Default: http://localhost:8000/mcp/
GRAPHITI_MCP_URL=

# Phase 6's formalized recheck interval (days), shared by Phase 5's overlap detection and Phase 6's
# Knowledge Update Agent. Defaults: fast=14, medium=60, slow=180, mixed=60.
RECHECK_INTERVAL_DAYS_FAST=14
RECHECK_INTERVAL_DAYS_MEDIUM=60
RECHECK_INTERVAL_DAYS_SLOW=180
RECHECK_INTERVAL_DAYS_MIXED=60

# Continuous Learning Agent (Phase 6): how many recent completed courses' domains to check for
# clustering, and the top domain's share at/above which the branch suggestion is biased toward
# diversity. Defaults: 5 and 0.6.
DIVERSITY_WINDOW_N=5
DIVERSITY_CLUSTER_THRESHOLD=0.6

# Teaching Engine voice layer (Phase 7.5): which TTS backend the Lesson screen's AudioPlayer uses.
# "openai" (default, production) or "browser" (Stage 1 prototype — window.speechSynthesis, zero
# API cost, no key needed; a manual dev opt-in, not an automatic fallback when OPENAI_API_KEY is
# missing — see README).
TTS_PROVIDER=openai

# OpenAI API key — required when TTS_PROVIDER=openai. Get one at https://platform.openai.com/
OPENAI_API_KEY=

# OpenAI TTS model. Default: tts-1 ($15/1M chars — cost-optimal). "tts-1-hd" ($30/1M chars) or
# "gpt-4o-mini-tts" are documented, swappable alternates for higher quality.
OPENAI_TTS_MODEL=tts-1

# Local disk directory for cached lesson audio, keyed by content hash (Phase 7.5). Default: ./data/audio-cache
AUDIO_CACHE_DIR=

# Web Push (Phase 10): VAPID keys authenticating this server to push services (Knowledge Update
# major-severity alerts, the engagement-check inactivity nudge — see README). Generate a real pair
# with `npx web-push generate-vapid-keys`. Required for any real push send; a missing key degrades
# each push attempt to a logged, non-fatal failure (npm run knowledge-update/engagement-check still
# complete normally — see src/push/index.ts's PushError).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# A contact URI the push services can reach if they need to flag a problem with this server's
# sends — a mailto: address or a URL, per the Web Push protocol's own requirement.
VAPID_SUBJECT=mailto:you@example.com

# How many days of no ActivityEvent on a path counts as "gone quiet" — shared by the Dashboard's
# boredom-proofing (Phase 9) and the engagement-check push nudge (Phase 10). Default: 7.
BOREDOM_INACTIVITY_DAYS=7

# The goal-connection Dashboard message's cadence — hours between shows. Default: 20.
GOAL_CONNECTION_MIN_HOURS=20
