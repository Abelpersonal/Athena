# Anthropic API key — required for every Orchestrator call. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily API key — required for web search (Tavily MCP server). Get one at https://tavily.com/
TAVILY_API_KEY=

# Claude model used by the Orchestrator for every LLM call. Change this one line to swap models —
# no code changes needed. Defaults to a mid/high-tier current Claude model (see README).
ORCHESTRATOR_MODEL=claude-sonnet-5

# Max retry attempts when a model response fails schema validation before the Orchestrator
# surfaces a hard failure to the caller. Default: 2.
ORCHESTRATOR_MAX_RETRIES=2

# Where the Orchestrator writes its JSONL cost/latency log. Default: ./logs/orchestrator.jsonl
ORCHESTRATOR_LOG_PATH=
