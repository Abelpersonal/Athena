{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI learning platform",
  "type": "module",
  "scripts": {
    "harness": "tsx src/harness/cli.ts",
    "inspect": "tsx src/harness/inspect.ts",
    "inspect-graph": "tsx src/harness/inspectGraph.ts",
    "knowledge-update": "tsx src/knowledgeUpdate/cli.ts",
    "db:generate": "drizzle-kit generate",
